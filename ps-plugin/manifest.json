{
  "manifestVersion": 5,
  "id": "local.moya.bridge",
  "name": "Moya",
  "version": "1.1.1",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.0.0", "data": { "apiVersion": 2 } },
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin-48.png", "scale": [1], "theme": ["darkest", "dark", "medium", "light", "lightest"], "species": ["generic"] },
    { "width": 48, "height": 48, "path": "icons/plugin-96.png", "scale": [2], "theme": ["darkest", "dark", "medium", "light", "lightest"], "species": ["generic"] }
  ],
  "entrypoints": [
    { "type": "panel", "id": "bridge", "label": { "default": "Moya" }, "minimumSize": { "width": 240, "height": 260 }, "preferredDockedSize": { "width": 280, "height": 320 }, "icons": [
      { "width": 23, "height": 23, "path": "icons/panel-23.png", "scale": [1], "theme": ["darkest", "dark", "medium", "light", "lightest"] },
      { "width": 23, "height": 23, "path": "icons/panel-46.png", "scale": [2], "theme": ["darkest", "dark", "medium", "light", "lightest"] }
    ] },
    { "type": "command", "id": "edit", "label": { "default": "Edit in Moya" } },
    { "type": "command", "id": "reedit", "label": { "default": "Re-edit selected Moya group" } }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": ["ws://127.0.0.1:47811", "ws://localhost/"] },
    "launchProcess": { "extensions": ["", ".app", ".exe"], "schemes": [] }
  }
}
